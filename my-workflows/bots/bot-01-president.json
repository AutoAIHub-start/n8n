{
  "name": "Bot-01-President-Router",
  "nodes": [
    {
      "parameters": {
        "updates": [
          "message"
        ]
      },
      "id": "1a2b3c4d-0001-4000-8000-000000000001",
      "name": "Telegram Trigger (President)",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.1,
      "position": [
        250,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "President Bot Telegram Account"
        }
      }
    },
    {
      "parameters": {
        "modelName": "models/gemini-1.5-pro",
        "options": {
          "systemInstruction": "你是团队的总控 President (@Dgtmaneser_bot)。你的职责是接收用户的指令，分析意图，并将任务分发给对应的子 Bot（如网页设计、市场营销、国际物流、财务等）。"
        }
      },
      "id": "1a2b3c4d-0002-4000-8000-000000000002",
      "name": "President AI Decision Engine",
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.4,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $('Telegram Trigger (President)').item.json.message.chat.id }}",
        "text": "={{ $json.output }}"
      },
      "id": "1a2b3c4d-0003-4000-8000-000000000003",
      "name": "Send Message Back",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        720,
        300
      ],
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "President Bot Telegram Account"
        }
      }
    }
  ],
  "connections": {
    "Telegram Trigger (President)": {
      "main": [
        [
          {
            "node": "President AI Decision Engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "President AI Decision Engine": {
      "main": [
        [
          {
            "node": "Send Message Back",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
